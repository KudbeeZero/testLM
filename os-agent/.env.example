# ============================================================
# OS Agent configuration
# See ENVIRONMENT.md (workspace root) for the full reference.
# ============================================================

# Which model provider to use: "local" | "gemini" | "grok" | "deepseek"
MODEL_PROVIDER=local

# --- Local (LM Studio) ---
LOCAL_MODEL=qwen/qwen3-1.7b
LM_STUDIO_BASE_URL=ws://localhost:1234

# --- Gemini (Google AI) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Grok (xAI) ---
# https://console.x.ai/team/default/api-keys
XAI_API_KEY=
GROK_MODEL=grok-4.3

# --- DeepSeek ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Lightning AI ---
LIGHTNING_API_KEY=
LIGHTNING_USER_ID=

# --- Neon (serverless Postgres) ---
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_API_PRODUCTION=https://HOST/DB/rest/v1
PG_DB_LOCAL=agent_local
PG_DB_GEMINI=agent_gemini
PG_DB_GROK=agent_grok
PG_DB_DEEPSEEK=agent_deepseek

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash Vector (1536-dim) ---
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- Upstash Box ---
UPSTASH_BOX_API_KEY=

# --- Upstash QStash ---
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Budget & rate limits ---
MONTHLY_BUDGET_USD=50
RATE_LIMIT_PER_MINUTE=30
MODEL_TTL_SECONDS=600
