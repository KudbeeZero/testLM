# ============================================================
# OS Agent configuration
# See ENVIRONMENT.md (workspace root) for the full reference.
# ============================================================

# Which model provider to use: "local" | "gemini" | "grok" | "deepseek"
MODEL_PROVIDER=local

# --- Local (LM Studio) ---
# Phi-4-mini is the preferred free local inference model (Qwen3-1.7B is legacy/pending removal).
LOCAL_MODEL=microsoft/phi-4-mini
LM_STUDIO_BASE_URL=http://localhost:1234

# --- Gemini (Google AI) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Grok (xAI) ---
# https://console.x.ai/team/default/api-keys
XAI_API_KEY=
GROK_MODEL=grok-4.3

# --- DeepSeek ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Lightning AI ---
LIGHTNING_API_KEY=
LIGHTNING_USER_ID=

# --- Neon (serverless Postgres) ---
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_API_PRODUCTION=https://HOST/DB/rest/v1
PG_DB_LOCAL=agent_local
PG_DB_GEMINI=agent_gemini
PG_DB_GROK=agent_grok
PG_DB_DEEPSEEK=agent_deepseek

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash Vector (1536-dim) ---
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- Upstash Box ---
UPSTASH_BOX_API_KEY=

# --- Upstash QStash ---
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Dashboard access control (enterprise RBAC) ---
# DASHBOARD_AUTH=true requires login; set false for single-operator local testing.
DASHBOARD_AUTH=true
# Role passwords (each grants the matching role).
DASHBOARD_PASSWORD=          # operator
DASHBOARD_ADMIN_PASSWORD=    # admin
DASHBOARD_VIEWER_PASSWORD=   # viewer (read-only)
# Static API key for programmatic/script access (Authorization: Bearer <key>).
DASHBOARD_API_KEY=
DASHBOARD_API_KEY_ROLE=operator

# --- Budget & rate limits ---
MONTHLY_BUDGET_USD=50
RATE_LIMIT_PER_MINUTE=30
MODEL_TTL_SECONDS=600

# --- Level 0-4 Mayor routing (os-agent/src/router.js) ---
# ROUTER_ENABLED=true routes tasks through the Level 0-4 hierarchy.
# When false, the legacy single-provider path (MODEL_PROVIDER) is used.
ROUTER_ENABLED=false
PHI4_ENABLED=true
PHI4_MAX_CONTEXT=8192
PHI4_TIMEOUT_MS=60000
PHI4_MAX_INPUT=4000
PHI4_ESCALATION_ENABLED=true
ROUTER_DEFAULT_LEVEL=1

# Optional per-token pricing (USD per 1K). Leave 0 to mark cost as unknown.
GEMINI_IN_PER_1K=0
GEMINI_OUT_PER_1K=0
GROK_IN_PER_1K=0
GROK_OUT_PER_1K=0
